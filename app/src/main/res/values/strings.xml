    <!-- Services -->
    <string name="services_eyebrow">Services</string>
    <string name="services_title">Everything you need, under one roof.</string>
    <string name="svc_usg_name">Ultrasound</string>
    <string name="svc_usg_tag">USG</string>
    <string name="svc_usg_desc">See how your baby is growing, or get a clear look at your abdomen and pelvis. We’ll explain what the scan shows before you leave.</string>
    <string name="svc_echo_name">Echocardiogram</string>
    <string name="svc_echo_tag">ECHO</string>
    <string name="svc_echo_desc">A painless scan that shows how well your heart is pumping. Doctors often suggest one after breathlessness, chest pain or a murmur.</string>
    <string name="svc_gyn_name">Gynecology &amp; maternal care</string>
    <string name="svc_gyn_desc">Check-ups before, during and after pregnancy, and someone to talk to about periods, PCOS or anything else on your mind.</string>
    <string name="svc_card_name">Cardiology</string>
    <string name="svc_card_desc">For blood pressure, palpitations or chest discomfort, or simply a check-up if heart trouble runs in your family.</string>
    <string name="svc_opd_name">General OPD</string>
    <string name="svc_opd_desc">Fever, cough, a stomach upset or a routine check-up. See a doctor any day of the week, for anyone in the family.</string>
