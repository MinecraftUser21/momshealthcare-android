    <!-- Services -->
    <string name="svc_usg_name">Ultrasound</string>
    <string name="svc_usg_short">Pregnancy, abdomen and pelvis scans.</string>
    <string name="svc_usg_desc">See how your baby is growing, or get a clear look at your abdomen and pelvis. We’ll explain what the scan shows before you leave.</string>
    <string name="svc_echo_name">Echocardiogram</string>
    <string name="svc_echo_short">A painless scan of how your heart pumps.</string>
    <string name="svc_echo_desc">A painless scan that shows how well your heart is pumping. Doctors often suggest one after breathlessness, chest pain or a murmur.</string>
    <string name="svc_gyn_name">Gynecology &amp; maternal care</string>
    <string name="svc_gyn_short">Before, during and after pregnancy.</string>
    <string name="svc_gyn_desc">Check-ups before, during and after pregnancy, and someone to talk to about periods, PCOS or anything else on your mind.</string>
    <string name="svc_card_name">Cardiology</string>
    <string name="svc_card_short">BP, palpitations and heart check-ups.</string>
    <string name="svc_card_desc">For blood pressure, palpitations or chest discomfort, or simply a check-up if heart trouble runs in your family.</string>
    <string name="svc_opd_name">General OPD</string>
    <string name="svc_opd_short">A doctor every day, for the whole family.</string>
    <string name="svc_opd_desc">Fever, cough, a stomach upset or a routine check-up. See a doctor any day of the week, for anyone in the family.</string>
    <string name="how_to_prepare">How to prepare</string>
    <string name="prep_note">General guidance. The clinic will confirm exactly what you need when they call.</string>
    <string name="book_this">Book %1$s</string>

    <string-array name="prep_usg">
        <item>Abdominal scans: usually nothing to eat for 6–8 hours before. Water is fine.</item>
        <item>Pelvic and early pregnancy scans: a full bladder helps. Drink 4–5 glasses of water an hour before and don’t empty your bladder.</item>
        <item>Bring previous scan reports and your doctor’s prescription.</item>
    </string-array>
    <string-array name="prep_echo">
        <item>No fasting or special preparation is needed.</item>
        <item>Wear a loose top that’s easy to open at the front.</item>
        <item>Bring earlier ECG or ECHO reports and a list of your medicines.</item>
    </string-array>
    <string-array name="prep_gyn">
        <item>Note the first day of your last period.</item>
        <item>Bring your antenatal card and previous reports, if you have them.</item>
        <item>List any medicines or supplements you take.</item>
    </string-array>
    <string-array name="prep_card">
        <item>Bring earlier ECG, ECHO and blood test reports.</item>
        <item>Bring your current medicines, or a list of them.</item>
        <item>If you check your blood pressure at home, bring your recent readings.</item>
    </string-array>
    <string-array name="prep_opd">
        <item>Bring previous prescriptions and reports.</item>
        <item>Note when the symptoms started and any medicines already taken.</item>
    </string-array>

    <!-- Visit tips -->
    <string name="tile_safe_title">Painless and radiation-free</string>
    <string name="tile_safe_body">USG and ECHO use sound waves only. No needles, no radiation.</string>
    <string name="tile_prep_title">Come prepared</string>
    <string name="tile_prep_body">Some scans need fasting or a full bladder. Bring previous reports and prescriptions.</string>
    <string name="tile_doc_title">Results, then a doctor</string>
    <string name="tile_doc_body">Gynecology, cardiology and OPD doctors are in the same building to review your report.</string>

