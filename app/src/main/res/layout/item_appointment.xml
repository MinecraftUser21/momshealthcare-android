<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Moms.Card"
    android:layout_marginBottom="12dp"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_soft"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            tools:text="Waiting for call" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dateShort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moms.Caption"
            tools:text="Sat, 25 Oct" />
    </LinearLayout>

    <TextView
        android:id="@+id/service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textAppearance="@style/TextAppearance.Moms.Headline"
        tools:text="Ultrasound (USG)" />

    <TextView
        android:id="@+id/when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Saturday, 25 October · Morning, 8 AM – 12 PM" />

    <TextView
        android:id="@+id/who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Moms.BodySmall"
        tools:text="For Priya Das · 98765 43210" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryAction"
            style="@style/Widget.Moms.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            app:backgroundTint="@color/btn_secondary_bg"
            tools:text="Add to calendar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondaryAction"
            style="@style/Widget.Moms.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text"
            app:backgroundTint="@color/btn_secondary_bg"
            tools:text="Cancel" />
    </LinearLayout>
</LinearLayout>
