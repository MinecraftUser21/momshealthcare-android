<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/title"
            style="@style/Moms.ScreenTitle"
            android:text="@string/tab_clinic" />

        <!-- Where -->
        <LinearLayout
            android:id="@+id/infoCard"
            style="@style/Moms.Card"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_mark"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand"
                        android:textAppearance="@style/TextAppearance.Moms.Strong" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/statusDot"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/dot_open"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textAppearance="@style/TextAppearance.Moms.BodySmall"
                            tools:text="Open now · until 9 PM" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/address"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/address_meta"
                android:textAppearance="@style/TextAppearance.Moms.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/directions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/get_directions" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/call"
                    style="@style/Widget.Moms.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/call" />
            </LinearLayout>

            <include
                android:id="@+id/copyRow"
                layout="@layout/item_row" />
        </LinearLayout>

        <!-- Hours -->
        <TextView
            style="@style/Moms.SectionHeader"
            android:text="@string/opening_hours" />

        <LinearLayout
            android:id="@+id/hours"
            style="@style/Moms.Card"
            android:paddingVertical="8dp" />

        <!-- Services -->
        <TextView
            style="@style/Moms.SectionHeader"
            android:text="@string/services" />

        <LinearLayout
            android:id="@+id/serviceList"
            style="@style/Moms.Card"
            android:paddingVertical="8dp" />

        <!-- Emergency -->
        <LinearLayout
            android:id="@+id/emergency"
            style="@style/Moms.Card"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ambulance"
                app:tint="@color/closed" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_title"
                    android:textAppearance="@style/TextAppearance.Moms.Strong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/emergency_body"
                    android:textAppearance="@style/TextAppearance.Moms.BodySmall"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/call112"
                style="@style/Widget.Moms.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/call_112" />
        </LinearLayout>

        <!-- Settings -->
        <TextView
            style="@style/Moms.SectionHeader"
            android:text="@string/settings" />

        <LinearLayout
            android:id="@+id/settings"
            style="@style/Moms.Card"
            android:paddingVertical="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/privacy_note"
            android:textAppearance="@style/TextAppearance.Moms.Caption" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Moms.Caption"
            tools:text="Version 1.1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
