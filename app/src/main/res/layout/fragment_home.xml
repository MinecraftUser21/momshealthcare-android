<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="12dp"
        android:paddingBottom="104dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_mark"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Moms.Label"
                    tools:text="Good evening" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/brand"
                    android:textAppearance="@style/TextAppearance.Moms.Headline"
                    android:textSize="20sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/headerCall"
                style="@style/Widget.Moms.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_call"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_phone" />
        </LinearLayout>

        <!-- Open / closed, with the website's heartbeat line -->
        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Moms.Card"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/statusDot"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/dot_open"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.Moms.Headline"
                    tools:text="Open now" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Moms.BodySmall"
                tools:text="@string/status_open_sub" />

            <com.momshealthcare.app.EcgView
                android:id="@+id/ecg"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginHorizontal="-20dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Next appointment -->
        <LinearLayout
            android:id="@+id/upcoming"
            style="@style/Moms.Card"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_press"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/upcoming"
                android:textAppearance="@style/TextAppearance.Moms.Label"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/text_2" />

            <TextView
                android:id="@+id/upcomingService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Moms.Headline"
                tools:text="Ultrasound (USG)" />

            <TextView
                android:id="@+id/upcomingWhen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Sat, 25 Oct · Morning, 8 AM – 12 PM" />

            <TextView
                android:id="@+id/upcomingWho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Moms.BodySmall"
                tools:text="For Priya Das" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/upcomingCalendar"
                style="@style/Widget.Moms.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_to_calendar"
                app:backgroundTint="@color/btn_secondary_bg"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- Quick actions -->
        <LinearLayout
            android:id="@+id/quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- Services -->
        <TextView
            android:id="@+id/servicesHeader"
            style="@style/Moms.SectionHeader"
            android:text="@string/services" />

        <HorizontalScrollView
            android:id="@+id/servicesScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/serviceRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Tips -->
        <TextView
            android:id="@+id/tipsHeader"
            style="@style/Moms.SectionHeader"
            android:text="@string/before_you_come" />

        <LinearLayout
            android:id="@+id/tips"
            style="@style/Moms.Card"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/home_footer"
            android:textAppearance="@style/TextAppearance.Moms.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
