<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Moms.Card"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:tint="@color/text"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_clock" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:textAppearance="@style/TextAppearance.Moms.Strong"
        android:textSize="19sp"
        tools:text="Open every day" />

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.1"
        android:textAppearance="@style/TextAppearance.Moms.BodySmall"
        tools:text="8:00 AM to 9:00 PM, including Sundays." />

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/statusDot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/dot_open"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/text"
            android:textSize="14sp"
            tools:text="Open now · until 9 PM" />
    </LinearLayout>
</LinearLayout>
