<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_activated="true"><shape android:shape="rectangle"><solid android:color="@color/field" /><stroke android:width="1.5dp" android:color="@color/closed" /><corners android:radius="@dimen/field_radius" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/field" /><stroke android:width="1.5dp" android:color="@color/text_2" /><corners android:radius="@dimen/field_radius" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="@color/field" /><stroke android:width="1.5dp" android:color="@color/text_2" /><corners android:radius="@dimen/field_radius" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/field" /><stroke android:width="1.5dp" android:color="@android:color/transparent" /><corners android:radius="@dimen/field_radius" /></shape></item>
</selector>
